    {
      "type": "timeseries",
      "id": 1,
      "title": "T° media diaria — todas las parcelas (filtradas)",
      "datasource": {"type": "influxdb", "uid": "efmenrhxbdclcc"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 1},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "influxdb", "uid": "efmenrhxbdclcc"},
          "query": "from(bucket: \"agro_iot_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\")\n  |> filter(fn: (r) => r.variable == \"temperatura_aire\")\n  |> filter(fn: (r) => contains(value: r.parcela, set: ${parcela:json}))\n  |> aggregateWindow(every: 1d, fn: mean, createEmpty: false)\n  |> group(columns: [\"parcela\", \"ubicacion\", \"cultivo\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 5,
                     "showPoints": "never"},
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom",
                   "calcs": ["min", "max", "mean", "stdDev"]}
      }
    },
